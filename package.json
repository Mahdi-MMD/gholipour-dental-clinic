{
  "name": "gholipour-dental-clinic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "optimize-images": "node scripts/optimize-images.js",
    "prebuild": "node scripts/optimize-images.js",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:poll": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev:clean": "npm run clean && npm run dev"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.15",
    "firebase": "^13.0.0",
    "minisearch": "^7.2.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "swiper": "^11.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
